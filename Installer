#!/bin/bash

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
X='\033[0m'

[ -z "${BASH_VERSION:-}" ] && echo "${RED}[!] This script must be run with bash" && exit 1
[ -z "${TERMUX_VERSION:-}" ] && echo "${RED}[!] This script must be ran in Termux" && exit 1

BIN="/data/data/com.termux/files/usr/bin"
DEX_BIN="$BIN/rish_shizuku.dex"
RISH_BIN="$BIN/rish"

declare -A files=(
    ["rish_shizuku.dex"]="https://github.com/duckofduckers/Shizuku-Rish-Setup/raw/main/rish_shizuku.dex"
    ["rish"]="https://github.com/duckofduckers/Shizuku-Rish-Setup/raw/main/rish"
)

all_exist=true

for filename in "${!files[@]}"; do
    filepath="$BIN/$filename"
    url="${files[$filename]}"

    if [[ -f "$filepath" ]]; then
        echo -e "${YELLOW}[-] $filename found${X}"
    else
        all_exist=false
        echo -e "${YELLOW}[-] Installing $filename...${X}"
        curl -fsS -L -o "$filepath" "$url"

        if [[ "$filename" == "rish" ]]; then
            chmod +x "$filepath"
        fi

        if [[ -f "$filepath" ]]; then
            echo -e "${GREEN}[*] $filename installed successfully${X}"
        else
            echo -e "${RED}[!] $filename not installed successfully${X}"
        fi
    fi
done

if [[ "$all_exist" == true ]]; then
    echo -e "${BLUE}[*] rish files already exist${X}"
fi

unset RED GREEN YELLOW BLUE X BIN DEX_BIN RISH_BIN files all_exist filename filepath url
